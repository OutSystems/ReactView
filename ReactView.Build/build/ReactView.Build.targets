<Project>

  <!--
    Two things happen on every build of a project that references this package:

      1. RV_GenerateViews   generates the C# bindings (ts2lang + tools/generator/ViewGenerator.js) for the
                            TypeScript files selected by the project's ts2lang.json.
      2. RV_GenerateBundle  bundles the views, the default stylesheets and the workers with webpack and embeds the
                            resulting .js, .css and .entry files as resources.

    Nothing is written into the project folder. Everything lands under $(IntermediateOutputPath)reactview/:

      cs/       the generated C# files, added to Compile
      out/      the bundles, entry files and manifest, embedded with the same resource names they had when they
                lived in the project folder (the paths in ts2lang.json, e.g. Generated/MainView.js)
      cache/    the webpack filesystem cache (Debug builds)
      *.stamp   up-to-date markers of the two steps

    Both steps run the Node tooling from $(ReactViewToolsPath), which RV_PrepareTools installs on first use from
    the lockfile shipped with the package. NODE_PATH points the compiled webpack configurations at that install.
  -->

  <PropertyGroup>
    <CleanDependsOn>
      RV_Clean;
      $(CleanDependsOn);
    </CleanDependsOn>
  </PropertyGroup>

  <!-- /// -->
  <!-- Webpack options -->
  <!-- /// -->
  <PropertyGroup Condition="'$(WP_OptimizeBundle)' == ''">
    <WP_OptimizeBundle>false</WP_OptimizeBundle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WP_ConfigFileName)' == ''">
    <WP_ConfigFileName>webpack_views</WP_ConfigFileName>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Split(&quot;_&quot;)[0].StartsWith('Debug'))">
    <WP_Mode>development</WP_Mode>
    <WP_DevTool>inline-source-map</WP_DevTool>
    <WP_UseCache>true</WP_UseCache>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Split(&quot;_&quot;)[0].StartsWith('Release'))">
    <WP_Mode>production</WP_Mode>
    <WP_DevTool>source-map</WP_DevTool>
    <WP_UseCache>false</WP_UseCache>
  </PropertyGroup>

  <ItemGroup>
    <VG_Inputs Include="**\*.tsx" Exclude="node_modules\**\*.tsx" />
    <VG_Inputs Include="**\*.ts" Exclude="node_modules\**\*.ts;**\*.d.ts" />
    <VG_Inputs Include="**\*.scss" Exclude="node_modules\**\*.scss" />
    <!-- a project that consumes a plugins project rebundles when the plugins sources change -->
    <VG_Inputs Condition="'$(PluginsRelativePath)' != ''" Include="$(PluginsRelativePath)**\*.tsx;$(PluginsRelativePath)**\*.ts;$(PluginsRelativePath)**\*.scss;$(PluginsRelativePath)webpack-output-config.json" Exclude="$(PluginsRelativePath)node_modules\**;$(PluginsRelativePath)**\*.d.ts" />
  </ItemGroup>

  <ItemGroup>
    <VG_StyleSheet_Inputs Include="@(DefaultStyleSheet)"/>
    <VG_StyleSheet_Inputs Condition="'@(DefaultStyleSheet)' != ''" Include="**\*.scss" Exclude="node_modules\**\*.scss" />
    <VG_Workers_Inputs Include="@(Workers)" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="@(VG_Inputs)" Exclude="@(UpToDateCheckInput)" />
    <UpToDateCheckInput Include="@(DefaultStyleSheet)" Exclude="@(UpToDateCheckInput)" />
    <UpToDateCheckInput Include="@(VG_Workers)" Exclude="@(UpToDateCheckInput)" />
  </ItemGroup>

  <!-- /// -->
  <!-- Tooling setup -->
  <!-- /// -->
  <Target Name="RV_SetVariables">
    <PropertyGroup>
      <ReactViewIntermediatePath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'reactview'))</ReactViewIntermediatePath>
      <RV_GeneratedPath>$([MSBuild]::NormalizePath('$(ReactViewIntermediatePath)', 'cs'))</RV_GeneratedPath>
      <RV_OutputPath>$([MSBuild]::NormalizePath('$(ReactViewIntermediatePath)', 'out'))</RV_OutputPath>
      <RV_ViewsStamp>$(ReactViewIntermediatePath)views.stamp</RV_ViewsStamp>
      <RV_BundleStamp>$(ReactViewIntermediatePath)bundle.stamp</RV_BundleStamp>

      <RV_ToolsEnvironment>NODE_PATH=$(ReactViewToolsNodeModules)</RV_ToolsEnvironment>
      <RV_Ts2LangScript>$(ReactViewToolsNodeModules)/@outsystems/ts2lang/ts2lang-main.js</RV_Ts2LangScript>
      <RV_GeneratorTemplate>$(ReactViewBuildToolsSourcePath)generator/ViewGenerator.js</RV_GeneratorTemplate>
      <RV_WebpackScript>$(ReactViewToolsNodeModules)/webpack/bin/webpack.js</RV_WebpackScript>
      <RV_WebpackConfigPath>$(ReactViewBuildToolsSourcePath)webpack/</RV_WebpackConfigPath>
      <RV_InstallScript>$(ReactViewBuildToolsSourcePath)install.js</RV_InstallScript>
    </PropertyGroup>
    <MakeDir Directories="$(ReactViewIntermediatePath)" />
  </Target>

  <!-- Resolves the Node.js executable once. Version managers (nodenv, nvm, volta) install shims that pick a version from
       the directory of the script being run, so the tools must be run through the real executable the check saw. -->
  <Target Name="RV_CheckNode" DependsOnTargets="RV_SetVariables">
    <Exec Command="&quot;$(ReactViewNodeExe)&quot; -p &quot;process.versions.node + ';' + process.execPath&quot;" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="RV_NodeExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="RV_NodeInfo" />
    </Exec>
    <Error Condition="'$(RV_NodeExitCode)' != '0'" Text="ReactView.Build requires Node.js $(ReactViewMinimumNodeMajor) or later on the PATH (or set ReactViewNodeExe). '$(ReactViewNodeExe)' could not be run." />
    <PropertyGroup>
      <RV_NodeVersion>$(RV_NodeInfo.Trim().Split(';')[0])</RV_NodeVersion>
      <RV_NodeExe>$(RV_NodeInfo.Trim().Split(';')[1])</RV_NodeExe>
      <RV_NodeMajor>$(RV_NodeVersion.Split('.')[0])</RV_NodeMajor>
    </PropertyGroup>
    <Error Condition="$([System.Int32]::Parse('$(RV_NodeMajor)')) &lt; $([System.Int32]::Parse('$(ReactViewMinimumNodeMajor)'))" Text="ReactView.Build requires Node.js $(ReactViewMinimumNodeMajor) or later, found $(RV_NodeVersion) ('$(ReactViewNodeExe)'). Set ReactViewNodeExe to a newer Node.js executable or update the one on the PATH." />
  </Target>

  <!-- Installs the Node dependencies of the tooling into $(ReactViewToolsPath) when they are not there yet -->
  <Target Name="RV_PrepareTools" DependsOnTargets="RV_CheckNode" Condition="'$(ReactViewSkipToolsInstall)' != 'true' And !Exists('$(ReactViewToolsNodeModules)/.reactview-installed')">
    <Error Condition="'$(ReactViewToolsId)' == ''" Text="ReactView.Build: tools id not found in the package ($(ReactViewBuildToolsSourcePath)toolsid.txt)." />
    <Message Importance="high" Text="Installing ReactView build tools ($(ReactViewToolsId)) into $(ReactViewToolsPath)" />
    <Exec Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_InstallScript)&quot; --source &quot;$(ReactViewBuildToolsSourcePath).&quot; --target &quot;$(ReactViewToolsPath)&quot; --min-node $(ReactViewMinimumNodeMajor)" />
  </Target>

  <!-- Copies the project templates (once) and the ambient type declarations (whenever they change) into the project -->
  <Target Name="RV_SetupProject" DependsOnTargets="RV_SetVariables">
    <ItemGroup>
      <_RVTemplates Include="$(ReactViewBuildContentPath)*.json" />
      <_RVDeclarations Include="$(ReactViewBuildContentPath)**\*.d.ts" />
    </ItemGroup>
    <Copy SourceFiles="@(_RVTemplates)" DestinationFolder="$(ProjectDir)%(_RVTemplates.RecursiveDir)" Condition="!Exists('$(ProjectDir)%(_RVTemplates.RecursiveDir)%(_RVTemplates.Filename)%(_RVTemplates.Extension)')" />
    <Copy SourceFiles="@(_RVDeclarations)" DestinationFolder="$(ProjectDir)%(_RVDeclarations.RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- /// -->
  <!-- View bindings generation -->
  <!-- /// -->
  <Target Name="RV_GetViewInputs" DependsOnTargets="RV_CheckNode;RV_PrepareTools;RV_SetupProject">
    <Exec ConsoleToMSBuild="True" EnvironmentVariables="$(RV_ToolsEnvironment)" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_Ts2LangScript)&quot; -l -f &quot;$(ProjectDir)ts2lang.json&quot; -t &quot;$(RV_GeneratorTemplate)&quot;">
      <Output TaskParameter="ConsoleOutput" ItemName="VGC_Inputs"/>
    </Exec>
    <ItemGroup>
      <UpToDateCheckInput Include="@(VGC_Inputs)" Exclude="@(UpToDateCheckInput)" />
    </ItemGroup>
  </Target>

  <Target Name="RV_GenerateViews" Inputs="@(VGC_Inputs);$(ProjectDir)ts2lang.json;$(RV_GeneratorTemplate);$(MSBuildThisFileFullPath)" Outputs="$(RV_ViewsStamp)" Condition="'$(UsingMicrosoftNETSdk)' != 'true' Or '$(DesignTimeBuild)' != 'true'" BeforeTargets="CustomTransformDuringBuild;TransformDuringBuild;AfterResolveReferences" DependsOnTargets="RV_GetViewInputs">
    <CallTarget Targets="RV_GenerateViewsInner" />
  </Target>

  <Target Name="RV_GenerateViewsInner">
    <Message Importance="High" Text="Generating View files" />
    <RemoveDir Directories="$(RV_GeneratedPath)" />
    <Exec EnvironmentVariables="$(RV_ToolsEnvironment);REACTVIEW_GENERATED_PATH=$(RV_GeneratedPath)" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_Ts2LangScript)&quot; -f &quot;$(ProjectDir)ts2lang.json&quot; -t &quot;$(RV_GeneratorTemplate)&quot;" />
    <Touch Files="$(RV_ViewsStamp)" AlwaysCreate="true" />
  </Target>

  <!-- old-format and new-format projects have different built-in targets. In order to support both we need to have two
       different alternative ways of adding the generated code to the target project -->
  <!-- Both run in design-time builds too, where RV_GenerateViews is skipped: they must set the paths up themselves and
       must never glob from an empty root -->
  <Target Name="RV_IncludeGeneratedFiles_NonSdk" DependsOnTargets="RV_SetVariables" BeforeTargets="CoreCompile" Condition="'$(UsingMicrosoftNETSdk)' != 'true'">
    <ItemGroup>
      <Compile Include="$(RV_GeneratedPath)\**\*.cs" Exclude="@(Compile)" Condition="'$(RV_GeneratedPath)' != '' And Exists('$(RV_GeneratedPath)')" />
    </ItemGroup>
  </Target>

  <Target Name="RV_IncludeGeneratedFiles_Sdk" DependsOnTargets="RV_SetVariables" AfterTargets="RV_GenerateViews" Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <ItemGroup>
      <Compile Include="$(RV_GeneratedPath)\**\*.cs" Exclude="@(Compile)" Condition="'$(RV_GeneratedPath)' != '' And Exists('$(RV_GeneratedPath)')" />
    </ItemGroup>
  </Target>

  <!-- /// -->
  <!-- Webpack bundle generation -->
  <!-- /// -->
  <Target Name="RV_GenerateBundle" Inputs="@(VG_Inputs);@(VG_Workers_Inputs);$(MSBuildThisFileFullPath);$(ReactViewBuildToolsSourcePath)toolsid.txt" Outputs="$(RV_BundleStamp)" Condition="'$(UsingMicrosoftNETSdk)' != 'true' Or '$(DesignTimeBuild)' != 'true'" AfterTargets="AfterResolveReferences" DependsOnTargets="RV_CheckNode;RV_PrepareTools;RV_SetupProject">
    <CallTarget Targets="RV_GenerateBundleInner" />
  </Target>

  <Target Name="RV_GenerateBundleInner">
    <Message Text="Generating bundle" Importance="high" />
    <RemoveDir Directories="$(RV_OutputPath)" />

    <!-- Default stylesheets bundle generation -->
    <CallTarget Condition="'@(VG_StyleSheet_Inputs)' != ''" Targets="RV_GenerateDefaultStyleSheet" />

    <!-- Workers bundle generation -->
    <CallTarget Condition="'@(VG_Workers_Inputs)' != ''" Targets="RV_GenerateWorkersBundle" />

    <!-- Main bundle generation -->
    <Exec EnvironmentVariables="$(RV_ToolsEnvironment)" IgnoreStandardErrorWarningFormat="true" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_WebpackScript)&quot; --config=&quot;$(RV_WebpackConfigPath)$(WP_ConfigFileName).config.js&quot; --mode=$(WP_Mode) --devtool=$(WP_DevTool) --env useCache=$(WP_UseCache) --env outputPath=&quot;$(RV_OutputPath)&quot; --env pluginsRelativePath='$(PluginsRelativePath)' --env assemblyName='$(AssemblyName)' --env optimizeBundle=$(WP_OptimizeBundle)" />

    <Touch Files="$(RV_BundleStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="RV_GenerateDefaultStyleSheet">
    <Exec EnvironmentVariables="$(RV_ToolsEnvironment)" IgnoreStandardErrorWarningFormat="true" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_WebpackScript)&quot; --config=&quot;$(RV_WebpackConfigPath)webpack_stylesheets.config.js&quot; --mode=$(WP_Mode) --devtool=$(WP_DevTool) --env useCache=$(WP_UseCache) --env outputPath=&quot;$(RV_OutputPath)&quot; --env entryPath='@(DefaultStyleSheet)' --env assemblyName='$(AssemblyName)'" />
  </Target>

  <Target Name="RV_GenerateWorkersBundle">
    <Exec EnvironmentVariables="$(RV_ToolsEnvironment)" IgnoreStandardErrorWarningFormat="true" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_WebpackScript)&quot; --config=&quot;$(RV_WebpackConfigPath)webpack_workers.config.js&quot; --mode=$(WP_Mode) --devtool=$(WP_DevTool) --env useCache=$(WP_UseCache) --env outputPath=&quot;$(RV_OutputPath)&quot; --env entryPath='@(Workers)'" />
  </Target>

  <!-- The bundles keep the resource names they had when they were written into the project folder: Link is the path
       relative to the output folder, which is what the generated C# refers to -->
  <Target Name="RV_IncludeGeneratedResources" DependsOnTargets="RV_SetVariables" AfterTargets="RV_GenerateBundle">
    <ItemGroup Condition="'$(RV_OutputPath)' != '' And Exists('$(RV_OutputPath)')">
      <_RVBundleOutputs Include="$(RV_OutputPath)\**\*.js;$(RV_OutputPath)\**\*.css;$(RV_OutputPath)\**\*.entry" Exclude="$(RV_OutputPath)\.bootstrap\**" />
      <EmbeddedResource Include="@(_RVBundleOutputs)" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- /// -->
  <!-- Dev server (hot reload) -->
  <!-- /// -->
  <!--
    dotnet msbuild <project> -t:ReactViewDevServer

    Runs webpack-dev-server in the foreground, bundling the views from the sources with react-refresh. An application
    whose ReactViewFactory.DevServerUri points at $(ReactViewDevServerUrl) loads its views from it and hot reloads them
    as the sources change. Build status: $(ReactViewDevServerUrl)/__reactview/status (and /__reactview/events).
  -->
  <Target Name="ReactViewDevServer" DependsOnTargets="RV_CheckNode;RV_PrepareTools;RV_SetupProject">
    <PropertyGroup>
      <RV_DevOutputPath>$([MSBuild]::NormalizePath('$(ReactViewIntermediatePath)', 'dev'))</RV_DevOutputPath>
      <RV_DevServerScript>$(ReactViewToolsNodeModules)/webpack-dev-server/bin/webpack-dev-server.js</RV_DevServerScript>
    </PropertyGroup>
    <Message Importance="high" Text="ReactView dev server for $(AssemblyName) at $(ReactViewDevServerUrl)" />
    <Exec EnvironmentVariables="$(RV_ToolsEnvironment)" IgnoreStandardErrorWarningFormat="true" Command="&quot;$(RV_NodeExe)&quot; &quot;$(RV_DevServerScript)&quot; --config=&quot;$(RV_WebpackConfigPath)webpack_views.config.js&quot; --mode=development --devtool=inline-source-map --env forHotReload=true --env useCache=false --env outputPath=&quot;$(RV_DevOutputPath)&quot; --env devServerUrl=&quot;$(ReactViewDevServerUrl)&quot; --env pluginsRelativePath='$(PluginsRelativePath)' --env assemblyName='$(AssemblyName)' --env optimizeBundle=false" />
  </Target>

  <!-- /// -->
  <!-- Clean -->
  <!-- /// -->
  <Target Name="RV_Clean" DependsOnTargets="RV_SetVariables" BeforeTargets="Clean">
    <RemoveDir Directories="$(ReactViewIntermediatePath)" />
  </Target>

</Project>
